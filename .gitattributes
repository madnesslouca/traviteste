# Files that run inside Linux containers must keep LF endings. Checked out with
# CRLF on Windows they fail with `bash\r: No such file or directory`.
*.sh        text eol=lf
*.php       text eol=lf
*.sql       text eol=lf
*.conf      text eol=lf
*.cnf       text eol=lf
Dockerfile  text eol=lf
*.yml       text eol=lf
*.twig      text eol=lf

# Binary assets: never touch, never diff.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.eot       binary
*.sqlite    binary
*.pdf       binary
