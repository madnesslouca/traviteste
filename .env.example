# Copy to .env and fill in. docker compose reads .env automatically.
# Never commit the filled-in .env.

# ---------------------------------------------------------------- identity db
# Defaults point at the bundled postgres service. To use your own Postgres,
# set IDENTITY_DB_HOST to it and stop the identity_db service - the schema is
# confined to `identity` and drops into an existing database safely.
IDENTITY_DB_HOST=identity_db
IDENTITY_DB_PORT=5432
IDENTITY_DB_NAME=identity
IDENTITY_DB_USER=identity
IDENTITY_DB_PASSWORD=identity

# ---------------------------------------------------------------- oauth
# Public base URL of this installation. The provider redirect URIs are derived
# from it, so it must match what you registered with Twitch and Kick exactly:
#   Twitch redirect  <OAUTH_PUBLIC_URL>/v1/oauth/twitch/callback
#   Kick redirect    <OAUTH_PUBLIC_URL>/v1/oauth/kick/callback
OAUTH_PUBLIC_URL=http://localhost:8080

# https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# https://kick.com/settings/developer
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# ---------------------------------------------------------------- coins api
# Shared secret your watch-time system sends as `Authorization: Bearer <token>`
# when crediting coins. Generate one with:  openssl rand -hex 32
# Leave empty and the coin endpoints refuse every request, which is the safe
# default - an unset token must never mean "open".
COINS_API_TOKEN=
