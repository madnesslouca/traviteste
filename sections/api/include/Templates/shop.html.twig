<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title }}</title>
    <style>
        :root {
            --bg: #0f1115;
            --panel: #171a21;
            --border: #262b36;
            --text: #e8e6e3;
            --muted: #8b93a7;
            --gold: #f5b942;
            --accent: #9146ff;
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            min-height: 100vh;
            padding: 2rem 1.5rem;
            background: radial-gradient(circle at 50% 0%, #1b2030 0%, var(--bg) 55%);
            color: var(--text);
            font: 16px/1.55 system-ui, -apple-system, "Segoe UI", sans-serif;
        }

        .wrap { max-width: 54rem; margin: 0 auto; }

        header {
            display: flex;
            flex-wrap: wrap;
            gap: 1rem;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 2rem;
        }

        h1 { margin: 0; font-size: 1.6rem; letter-spacing: -.01em; }

        .balance {
            padding: .6rem 1rem;
            background: var(--panel);
            border: 1px solid var(--border);
            border-radius: 999px;
            font-variant-numeric: tabular-nums;
        }

        .balance strong { color: var(--gold); }

        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
            gap: 1rem;
            margin-bottom: 2.5rem;
        }

        .pack {
            display: flex;
            flex-direction: column;
            padding: 1.25rem;
            background: var(--panel);
            border: 1px solid var(--border);
            border-radius: 12px;
        }

        .pack h2 { margin: 0 0 .75rem; font-size: 1rem; font-weight: 600; }

        .gold {
            margin-bottom: .25rem;
            color: var(--gold);
            font-size: 1.6rem;
            font-weight: 700;
            font-variant-numeric: tabular-nums;
        }

        .gold span { font-size: .85rem; font-weight: 400; color: var(--muted); }

        .cost {
            margin-bottom: 1.1rem;
            color: var(--muted);
            font-size: .9rem;
            font-variant-numeric: tabular-nums;
        }

        button {
            margin-top: auto;
            padding: .65rem 1rem;
            border: 0;
            border-radius: 8px;
            background: var(--accent);
            color: #fff;
            font-size: .95rem;
            font-weight: 600;
            cursor: pointer;
        }

        button:hover:not(:disabled) { filter: brightness(1.12); }

        button:disabled { background: #2b303b; color: var(--muted); cursor: not-allowed; }

        h3 {
            margin: 0 0 .9rem;
            font-size: .8rem;
            text-transform: uppercase;
            letter-spacing: .07em;
            color: var(--muted);
        }

        table { width: 100%; border-collapse: collapse; font-size: .9rem; }

        th, td { padding: .6rem .5rem; text-align: left; border-bottom: 1px solid var(--border); }

        th { color: var(--muted); font-weight: 500; font-size: .8rem; }

        td.num { text-align: right; font-variant-numeric: tabular-nums; }

        .tag {
            padding: .15rem .5rem;
            border-radius: 999px;
            font-size: .75rem;
            text-transform: uppercase;
            letter-spacing: .04em;
        }

        .delivered { background: rgba(83, 252, 24, .12); color: #8ef06a; }

        .unmatched { background: rgba(255, 176, 86, .12); color: #ffc078; }

        .failed { background: rgba(255, 86, 86, .12); color: #ffb0b0; }

        .msg {
            padding: .8rem 1rem;
            margin-bottom: 1.5rem;
            border-radius: 8px;
            font-size: .93rem;
        }

        .msg.bad { background: rgba(255, 86, 86, .1); border: 1px solid rgba(255, 86, 86, .35); color: #ffb0b0; }

        .msg.warn { background: rgba(255, 176, 86, .1); border: 1px solid rgba(255, 176, 86, .3); color: #ffc078; }

        .msg.good { background: rgba(83, 252, 24, .1); border: 1px solid rgba(83, 252, 24, .3); color: #a5f58a; }

        .empty { color: var(--muted); font-size: .9rem; }
    </style>
</head>
<body>
<div class="wrap">
    <header>
        <h1>{{ title }}</h1>
        <div class="balance"><strong>{{ balance }}</strong> {{ currency }}</div>
    </header>

    {% if botError %}
        <div class="msg warn">The stream shop is unavailable right now: {{ botError }}</div>
    {% endif %}
    {% if error %}
        <div class="msg bad">{{ error }}</div>
    {% endif %}
    {% if bought > 0 %}
        <div class="msg good">{{ bought }} gold added to your account.</div>
    {% endif %}

    <div class="grid">
        {% for item in items %}
            <article class="pack">
                <h2>{{ item.item_name }}</h2>
                <div class="gold">{{ item.gold_amount }} <span>gold</span></div>
                <div class="cost">{{ item.price }} {{ currency }}</div>
                <form method="post" action="/shop/buy">
                    <input type="hidden" name="csrf" value="{{ csrf }}">
                    <input type="hidden" name="item_id" value="{{ item.id }}">
                    <button type="submit" {% if balance < item.price %}disabled{% endif %}>
                        {% if balance < item.price %}Not enough {{ currency }}{% else %}Exchange{% endif %}
                    </button>
                </form>
            </article>
        {% endfor %}
    </div>

    {% if items is empty and not botError %}
        <p class="empty">No gold packs are set up yet.</p>
    {% endif %}

    <h3>Recent deliveries</h3>
    {% if history is empty %}
        <p class="empty">Nothing yet. Watch the stream to earn {{ currency }}.</p>
    {% else %}
        <table>
            <thead>
            <tr>
                <th>Redemption</th>
                <th class="num">Gold</th>
                <th>Status</th>
            </tr>
            </thead>
            <tbody>
            {% for row in history %}
                <tr>
                    <td>#{{ row.bot_redemption_id }}</td>
                    <td class="num">{{ row.gold_amount }}</td>
                    <td>
                        <span class="tag {{ row.status }}">{{ row.status }}</span>
                        {% if row.detail %}<br><span class="empty">{{ row.detail }}</span>{% endif %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}
</div>
</body>
</html>
