[mysqld]
# lower_case_table_names is deliberately NOT set. main.sql now creates the
# tables with the same camelCase names the PHP code queries (banIP, gameServers,
# paymentConfig, taskQueue, ...), so the default case-sensitive behaviour of a
# Linux MySQL/MariaDB is what we want. Forcing it to 1 only masked the mismatch
# and broke as soon as the volume had been initialised without this file.
character-set-server=utf8mb4
collation-server=utf8mb4_unicode_ci
max_allowed_packet=256M
innodb_buffer_pool_size=512M
