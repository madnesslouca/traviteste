<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title }}</title>
    <style>
        :root {
            --bg: #0f1115;
            --panel: #171a21;
            --border: #262b36;
            --text: #e8e6e3;
            --muted: #8b93a7;
            --twitch: #9146ff;
            --kick: #53fc18;
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            min-height: 100vh;
            display: grid;
            place-items: center;
            padding: 1.5rem;
            background: radial-gradient(circle at 50% 0%, #1b2030 0%, var(--bg) 60%);
            color: var(--text);
            font: 16px/1.55 system-ui, -apple-system, "Segoe UI", sans-serif;
        }

        .card {
            width: 100%;
            max-width: 26rem;
            padding: 2rem;
            background: var(--panel);
            border: 1px solid var(--border);
            border-radius: 14px;
            box-shadow: 0 18px 50px rgba(0, 0, 0, .45);
        }

        h1 { margin: 0 0 .35rem; font-size: 1.5rem; letter-spacing: -.01em; }

        .sub { margin: 0 0 1.75rem; color: var(--muted); font-size: .93rem; }

        label {
            display: block;
            margin-bottom: .45rem;
            font-size: .82rem;
            text-transform: uppercase;
            letter-spacing: .06em;
            color: var(--muted);
        }

        select {
            width: 100%;
            padding: .7rem .8rem;
            margin-bottom: 1.5rem;
            background: #0e1117;
            color: var(--text);
            border: 1px solid var(--border);
            border-radius: 8px;
            font-size: 1rem;
        }

        select:focus { outline: 2px solid var(--twitch); outline-offset: 1px; }

        .provider {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: .6rem;
            width: 100%;
            padding: .85rem 1rem;
            margin-bottom: .7rem;
            border: 0;
            border-radius: 8px;
            font-size: 1rem;
            font-weight: 600;
            text-decoration: none;
            cursor: pointer;
            transition: filter .15s ease, transform .15s ease;
        }

        .provider:hover { filter: brightness(1.12); }

        .provider:active { transform: translateY(1px); }

        .provider svg { width: 1.15rem; height: 1.15rem; fill: currentColor; }

        .twitch { background: var(--twitch); color: #fff; }

        .kick { background: var(--kick); color: #0b1005; }

        .note {
            margin: 1.5rem 0 0;
            padding-top: 1.25rem;
            border-top: 1px solid var(--border);
            color: var(--muted);
            font-size: .82rem;
        }

        .error {
            padding: .75rem .9rem;
            margin-bottom: 1.25rem;
            background: rgba(255, 86, 86, .1);
            border: 1px solid rgba(255, 86, 86, .35);
            border-radius: 8px;
            color: #ffb0b0;
            font-size: .9rem;
        }
    </style>
</head>
<body>
<main class="card">
    <h1>{{ title }}</h1>
    <p class="sub">Sign in with the account you stream and watch with.</p>

    {% if error %}
        <div class="error">{{ error }}</div>
    {% endif %}

    {% if worlds is empty %}
        <div class="error">No game world is open for registration right now.</div>
    {% else %}
        {% if worlds|length > 1 %}
            <label for="world">Game world</label>
            <select id="world">
                {% for world in worlds %}
                    <option value="{{ world.id }}">{{ world.title }} ({{ world.name }})</option>
                {% endfor %}
            </select>
        {% else %}
            <input type="hidden" id="world" value="{{ worlds[0].id }}">
        {% endif %}

        {% if 'twitch' in providers %}
            <a class="provider twitch" href="#" data-provider="twitch">
                <svg viewBox="0 0 24 24"><path d="M4.3 0 1.7 5.2v15.6h5.2V24h3l3-3.2h4.3L24 15.6V0H4.3zm17.1 14.7-3 3h-5.2l-3 3v-3H5.6V1.7h15.8v13zM17.5 6v6.2h-2V6h2zm-5.2 0v6.2h-2V6h2z"/></svg>
                Continue with Twitch
            </a>
        {% endif %}

        {% if 'kick' in providers %}
            <a class="provider kick" href="#" data-provider="kick">
                <svg viewBox="0 0 24 24"><path d="M2 2h6v6h2V5h2V2h6v6h-2v3h-2v2h2v3h2v6h-6v-3h-2v-3H8v6H2V2z"/></svg>
                Continue with Kick
            </a>
        {% endif %}

        {% if providers is empty %}
            <div class="error">No sign-in provider is configured. Set the client id and secret in .env.</div>
        {% endif %}
    {% endif %}

    <p class="note">
        Coins earned watching the stream are tied to this account, so sign in with
        the same one every time.
    </p>
</main>

<script>
    // The world has to travel with the sign-in request: the provider's callback
    // carries nothing but the state token, so the choice is made here.
    (function () {
        var world = document.getElementById('world');
        var links = document.querySelectorAll('[data-provider]');
        for (var i = 0; i < links.length; i++) {
            links[i].addEventListener('click', function (event) {
                event.preventDefault();
                var provider = this.getAttribute('data-provider');
                var id = world ? world.value : '';
                window.location.href = '/v1/oauth/' + provider + '/start?world=' + encodeURIComponent(id);
            });
        }
    })();
</script>
</body>
</html>
